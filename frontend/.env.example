# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit it.

# Supabase project URL (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — safe to ship to the browser; RLS enforces tenant isolation.
# (Replaces the legacy `anon` key. Find under Supabase Dashboard → Settings → API.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — server-only, RLS-bypassing. NEVER expose to the browser.
# (Replaces the legacy `service_role` key. Used for admin operations: ingestion,
# user provisioning, super-admin tasks. Leave blank until needed.)
SUPABASE_SECRET_KEY=

# ClassIQ FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
