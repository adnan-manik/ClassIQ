# Copy to `.env` (gitignored) and fill in real values.

# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://kmmkpfhwvgfntzjshuej.supabase.co

# JWT Secret — Supabase Dashboard → Settings → API → "JWT Secret"
# (NOT the publishable or secret API keys — this is the HMAC secret used to
# sign user JWTs. Used by the backend to verify access tokens.)
SUPABASE_JWT_SECRET=

# Optional: secret API key for admin operations (provisioning users, etc.)
SUPABASE_SECRET_KEY=

# ─── Database (session pooler, IPv4-friendly) ──────────────────────────────
# Format:
#   postgresql+asyncpg://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.kmmkpfhwvgfntzjshuej:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Log every SQL statement the backend issues. Useful when debugging a query,
# but it costs console I/O on every request — leave it off otherwise.
SQL_ECHO=false

# ─── LLM — S2 natural-language query ("Ask ClassIQ") ───────────────────────
# Backend-only. Leave the active provider's key empty to disable the feature
# (the API returns 503 and the page shows a "not configured" notice).
#
# LLM_PROVIDER picks which vendor is used: anthropic | groq.
# Only the selected provider's key needs to be set.
# Omitting this line entirely falls back to `anthropic` (the code default);
# this example ships `groq` because that's what the project runs on.
LLM_PROVIDER=groq

# Anthropic (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Groq (OpenAI-compatible; no prompt caching, so cache token counts stay 0)
GROQ_API_KEY=
# llama-3.3-70b-versatile was retired by Groq; list current ids with
# `client.models.list()` if this one is ever removed too.
GROQ_MODEL=openai/gpt-oss-120b

LLM_MAX_OUTPUT_TOKENS=4096
LLM_EFFORT=medium

# ─── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:3000
