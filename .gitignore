# Repo-root .gitignore (covers tools/scripts at root; subprojects have their own)

# Node deps anywhere (subprojects keep their own package.json tracked)
**/node_modules/

# Next.js build output anywhere (incl. a stray root-level .next from running next at root)
**/.next/

# Database scripts and security tests have tracked dependency manifests.

# Env files
.env*

# OS / editor cruft
.DS_Store
Thumbs.db

# MCP credentials cache (sometimes written by MCP servers)
.mcp.json

# Claude Code: keep team allowlist in .claude/settings.json, ignore personal
.claude/settings.local.json
.claude/cache/
.claude/history/
